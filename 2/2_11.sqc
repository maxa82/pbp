


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<sql.h>




EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hIdPrograma;
char hPredmet[1024];
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "GRESKA! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
    
}


/*
 
Zadatak 2.11: Napisati C/SQL program kojim se, za sve položene ispite čiji se naziv predmeta unosi sa standardnog ulaza, ocena uvećava za 1.
 */

int main()
{
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    printf("unesite naziv polozenog predmeta: \n");
   
    char predmet[1024];
    fgets(predmet, sizeof(predmet), stdin);
    predmet[strcspn(predmet, "\n")] = '\0';
    
    strcpy(hPredmet, predmet);
    
    EXEC SQL
        UPDATE      DA.ISPIT I
        SET       I.OCENA =
                    CASE
                        WHEN I.OCENA > 5 AND I.OCENA < 10 THEN I.OCENA + 1
                        ELSE I.OCENA
                    END
        WHERE       I.OCENA > 5 AND I.STATUS = 'o' AND 
                    I.IDPREDMETA IN (SELECT P.ID FROM DA.PREDMET P WHERE
                        P.NAZIV = :hPredmet
                    );
    checkSQL("UPDATE");
    
   
    EXEC SQL COMMIT;
    checkSQL("COMMIT");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}






































































