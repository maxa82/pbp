


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<sql.h>


/*
 
Zadatak 2.6: Napisati C/SQL program koji ispisuje broj studenata koji su upisali studije u godini koja se unosi sa standardnog ulaza.


 */

EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hGodina;
sqlint32 hBrojStudenata;
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "GRESKA! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
    
}

int main()
{
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    printf("unesite godinu: ");
    scanf("%d", &hGodina);
    
    //hBrojStudenata = -1;
    
    EXEC SQL 
        SELECT  COUNT(*) AS BROJSTUDENATA
        INTO    :hBrojStudenata
        FROM    DA.DOSIJE
        WHERE   :hGodina = YEAR(DATUPISA);
    checkSQL("SELECT INTO");
    
    printf("Broj studenata koji su upisali te godine je %d\n", hBrojStudenata);
    
    EXEC SQL COMMIT;
    checkSQL("COMMIT");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}






































































