


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<sql.h>


/*
 
 Zadatak 2.5: Napisati C/SQL program koji ispisuje podatke
 za predmet čiji je identifikator 1693.
 
 */

EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hId;
char hOznaka[21];
char hNaziv[151];
short hESPB;
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "GRESKA! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
    
}

int main()
{
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    
    EXEC SQL 
        SELECT  ID,
                OZNAKA,
                NAZIV,
                ESPB 
        INTO    :hId,
                :hOznaka,
                :hNaziv,
                :hESPB
        FROM    DA.PREDMET
        WHERE   ID = 1693;
    checkSQL("SELECT INTO");
    
    printf("\n%d %s %s %hd\n", hId,
                hOznaka,
                hNaziv,
                hESPB);
    
    
    EXEC SQL COMMIT;
    checkSQL("COMMIT");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}






































































