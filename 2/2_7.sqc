


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<sql.h>




EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
char hIme[51];
char hPrezime[51];
short hOcena;
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "GRESKA! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
    
}


/*
 
Zadatak 2.7: Napisati C/SQL program koji za svaku ocenu od 6 do 10 ispisuje ime i prezime studenta koji je poslednji položio neki ispit sa tom ocenom. U slučaju da ima više takvih studenata, klauzom LIMIT 1 naredbe SELECT INTO se osigurati da rezultat vrati najviše 1 rezultat. (Pomoć: Koristiti for petlju za menjanje vrednosti matične promenljive koja sadrži ocenu, pa u svakoj iteraciji dohvatiti informaciju za tekuću vrednost te matične promenljive.)


 
 */

int main()
{
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    for(int i = 6; i <= 10; i++)
    {   
        hOcena = i;
        EXEC SQL 
            SELECT      D.IME,
                        D.PREZIME
            INTO        :hIme,
                        :hPrezime
            FROM        DA.DOSIJE D JOIN DA.ISPIT I ON I.INDEKS = 
                        D.INDEKS
            WHERE       I.OCENA = :hOcena AND I.STATUS = 'o' AND 
                        I.DATPOLAGANJA >= ALL (SELECT I1.DATPOLAGANJA 
                            FROM DA.ISPIT I1
                            WHERE I1.OCENA = I.OCENA AND I1.STATUS = 'o' 
                        )
            LIMIT       1;
        checkSQL("SELECT INTO");
        
        printf("Za ocenu %hd to je student %s %s\n", hOcena, hIme, hPrezime);
    }       
    
    EXEC SQL COMMIT;
    checkSQL("COMMIT");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}






































































