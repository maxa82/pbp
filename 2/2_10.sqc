


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<sql.h>




EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hIdPrograma;
char hOznaka[11];
char hNaziv[51];
short hIdNivoa;
short hObimESPB;
char hZvanje[101];
// struct tag {
//     short int;
//     char[32672];
// }
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "GRESKA! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
    
}


/*
 
Zadatak 2.10: Napisati C/SQL program kojim se svim obaveznim predmetima na studijskom programu 'Informatika' povećava broj bodova za 2.



 */

int main()
{
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    EXEC SQL 
        UPDATE      DA.PREDMET P
        SET         ESPB = ESPB + 2
        WHERE       P.ID IN (
                    SELECT PP.IDPREDMETA
                    FROM DA.PREDMETPROGRAMA PP JOIN                             
                    DA.STUDIJSKIPROGRAM SP ON SP.ID = PP.IDPROGRAMA WHERE SP.NAZIV = 'Informatika' AND PP.VRSTA = 'obavezan'
                            );
    checkSQL("UPDATE");
    
   
    EXEC SQL COMMIT;
    checkSQL("COMMIT");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}






































































