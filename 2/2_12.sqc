


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<sql.h>




EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hIndeks;
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "GRESKA! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
    
}


/*
 
Zadatak 2.12: Napisati C/SQL program kojim se brišu svi podaci o ispitima za studenta ?iji se indeks unosi sa standardnog ulaza.


 */

int main()
{
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    printf("unesite indeks za studenta kome ce se obrisati svi podaci o ispitima:\n");
    
    
    scanf("%d", &hIndeks);
    
    EXEC SQL 
        DELETE FROM DA.ISPIT 
        WHERE   INDEKS = :hIndeks;
    checkSQL("DELETE");
    
   
    EXEC SQL COMMIT;
    checkSQL("COMMIT");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}






































































