












#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<sql.h>


EXEC SQL INCLUDE SQLCA;
/*
Zadatak 2.3: Napisati C/SQL program koji ispisuje indeks, ime, prezime, mesto rođenja (ukoliko je navedeno u bazi) i datum diplomiranja (ukoliko je navedeno u bazi) za studenta čiji se broj indeksa učitava sa standardnog ulaza.
*/


EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hIndeks;
char hIme[51];
char hPrezime[51];
char hMestoRodjenja[51];
short iMestoRodjenja;
char hDatumDiplomiranja[11];
short iDatumDiplomiranja;
EXEC SQL END DECLARE SECTION;


void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "GRESKA! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
}


int main(int argc, char* argv[])
{
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    printf("Unesite broj indeksa:\n");
    scanf("%d", &hIndeks);
    
    
    EXEC SQL
        SELECT      D.IME,
                    D.PREZIME,
                    D.MESTORODJENJA,
                    D.DATDIPLOMIRANJA
        INTO        :hIme,
                    :hPrezime,
                    :hMestoRodjenja :iMestoRodjenja,
                    :hDatumDiplomiranja :iDatumDiplomiranja
        FROM        DA.DOSIJE D
        WHERE       D.INDEKS = :hIndeks;
    checkSQL("SELECT INTO");
     
    if(strcmp(hIme,"") == 0)
        printf("Ne postoji student sa datim indeksom!\n");
    else
        printf("Student sa indeksom %d je:\n - %s\n - %s\n - %s\n - %s\n", hIndeks, hIme, hPrezime, iMestoRodjenja < 0 ? "NULL" : hMestoRodjenja, iDatumDiplomiranja < 0 ? "NULL" : hDatumDiplomiranja);
                    
    
    
    
    EXEC SQL COMMIT;
    checkSQL("COMMIT");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
    
}

































































