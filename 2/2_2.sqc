






#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<sql.h>


/*
 
 Zadatak 2.2: Napisati C/SQL program koji ispisuje indeks, ime, prezime, mesto rođenja (ukoliko je navedeno u bazi) i datum diplomiranja (ukoliko je navedeno u bazi) za studenta sa maksimalnim indeksom iz tabele ISPIT.


 
 */


EXEC SQL INCLUDE SQLCA;


// SEKCIJA
EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hIndeks;
char hIme[51];
char hPrezime[51];
char hMestoRodjenja[51];
short iMestoRodjenja;
char hDatumDiplomiranja[11];
short iDatumDiplomiranja;
EXEC SQL END DECLARE SECTION;


//checkSQL

void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "Greska! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
    }
    
}


int main(int argc, char *argv[])
{
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    
    
    EXEC SQL 
        SELECT      D.INDEKS,
                    D.IME,
                    D.PREZIME,
                    D.MESTORODJENJA,
                    D.DATDIPLOMIRANJA
        INTO        :hIndeks,
                    :hIme,
                    :hPrezime,
                    :hMestoRodjenja :iMestoRodjenja,
                    :hDatumDiplomiranja :iDatumDiplomiranja
        FROM        DA.DOSIJE D
        WHERE       D.INDEKS = (SELECT MAX(I.INDEKS) FROM 
                    DA.ISPIT I
        );
    checkSQL("SELECT INTO");
    
    
    printf("Trazeni student je: \n %d, %s, %s, %s, %s\n", hIndeks, hIme, hPrezime, iMestoRodjenja < 0 ? "Nije upisano mesto rodjenja" : hMestoRodjenja, iDatumDiplomiranja < 0 ? "Nije upisan datum diplomiranja" : hDatumDiplomiranja);
    
    
    EXEC SQL COMMIT;
    checkSQL("COMMIT PRE KRAJA");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
    
}















