

#include<stdio.h>
#include<stdlib.h>
#include<stdbool.h>
#include<sql.h>
#include<string.h>


EXEC SQL INCLUDE SQLCA;



// sekcija deklarisanja
EXEC SQL BEGIN DECLARE SECTION;

char hNaziv[31];
char hOznaka[21];
short hSkGodina;

EXEC SQL END DECLARE SECTION;



void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char buffer[1024];
        short bufferSize = sizeof(buffer);
        short lineWidth = 50;
        
        
        sqlaintp(buffer, bufferSize, lineWidth, &sqlca);
        
        fprintf(stderr, "greska! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", buffer);
        
        
        EXEC SQL ROLLBACK;
        EXEC SQL CONNECT RESET;
        
        exit(EXIT_FAILURE);
        
        
    }
    
    
}



int main(int argc, char** argv)
{
    EXEC SQL CONNECT TO stud2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    
    
    /*
     
     Zadatak 5.3: 
     
     Napisati C/SQL program kojim se za svaki ispitni rok, za koji postoji makar jedno polaganje, prvo ispisuju informacije o nazivu i godini roka, a zatim se korisnik pita da li želi da obriše sva polaganja za taj ispitni rok. Ukoliko želi, aplikacija izvršava brisanje i prikazuje poruku korisniku. 
     
     Obrada jednog ispitnog roka predstavlja jednu transakciju.



     
     */
    
    
    // Primetimo da smo morali da navedemo klauzu WITH HOLD ovde
    // zato sto vrsimo potvrdjivanje izmena tokom obrade kursora.
    EXEC SQL 
        DECLARE cRokovi CURSOR WITH HOLD FOR 
        SELECT  NAZIV,
                SKGODINA,
                OZNAKAROKA
        FROM    DA.ISPITNIROK IR
        WHERE EXISTS (
                    SELECT *
                    FROM DA.ISPIT I
                    WHERE I.SKGODINA = IR.SKGODINA AND I.OZNAKAROKA = IR.OZNAKAROKA
        );
    checkSQL("DECLARE");
    
    EXEC SQL OPEN cRokovi;
    checkSQL("OPEN");
    
    while(1)
    {
        EXEC SQL 
            FETCH       cRokovi
            INTO        :hNaziv,
                        :hSkGodina,
                        :hOznaka;
        checkSQL("FETCH INTO");
        
        
        if(SQLCODE == 100)
            break;
        
        printf("Ispitni rok %s %s u skolskoj godini %hd. \nDa li zelite da obrisete sva polaganja za dati ispitni rok? [d/n]", hNaziv, hOznaka, hSkGodina
        );
        
        char odg = getchar(); getchar();
        
        if(odg == 'n')
        {
            printf("Nije obrisano nista!\n");
            continue;
        }
        
        EXEC SQL 
            DELETE FROM DA.ISPIT
            WHERE   OZNAKAROKA = :hOznaka AND SKGODINA = :hSkGodina;
        checkSQL("DELETE FROM");
        
        
        printf("Brisanje je uspesno izvrseno za rok %s %s %hd!\n", hNaziv, hOznaka, hSkGodina);
        
        EXEC SQL COMMIT;
    checkSQL("COMMIT");
    
    }
    
    EXEC SQL CLOSE cRokovi;
    checkSQL("CLOSE");
    
    
    EXEC SQL COMMIT;
    checkSQL("COMMIT PRED KRAJ");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    exit(EXIT_SUCCESS);
}




























































