#include <stdio.h>
#include <stdlib.h>
#include <string.h>

EXEC SQL INCLUDE SQLCA;


EXEC SQL BEGIN DECLARE SECTION;

sqlint32 hIndeks;
short hGodina;
short hOdabrana_godina;
char hNazivPredmeta[151];
short hOcena;

EXEC SQL END DECLARE SECTION;

void checkSQL(const char *str) {
    if(SQLCODE < 0) {
        fprintf(stderr, "Greska %d: %s\n", SQLCODE, str);

        EXEC SQL ROLLBACK;

        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
    }
}



/*
Zadatak 5.8: Napisati C/SQL program koji redom:

- Kreira novi ispitni rok u 2020. godini čija je oznaka 'apr' i naziv 'April 2021'. Za početak prijavljivanja postaviti današnji datum i postaviti da prijavljivanje traje 15 dana.

- Ažurira datum kraja prijavljivanja za prethodno uneti ispitni rok tako što smanjuje trajanje prijavljivanja za 5 dana.


Obezbediti da se navedene operacije izvrše zasebno.


 */

int main() {
    EXEC SQL CONNECT TO stud2020 USER student USING abcdef;
    checkSQL("Connect");
    
   EXEC SQL
        INSERT INTO DA.ISPITNIROK
        VALUES  (2020, 'apr', 'April 2021', DATE('05/28/2026'), DATE('06/10/2026'));
    checkSQL("INSERT INTO");

    
    EXEC SQL COMMIT;
    checkSQL("COMMIT 1");
    
    
    EXEC SQL 
        UPDATE DA.ISPITNIROK
        SET     DATKRAJA = DATKRAJA - (5 DAYS)
        WHERE   SKGODINA = 2020 AND OZNAKAROKA = 'apr' AND NAZIV = 'April 2021';
    checkSQL("UPDATE");
   
    EXEC SQL COMMIT;
    checkSQL("Potvrdjivanje izmena");
    
    EXEC SQL CONNECT RESET;
    checkSQL("Connect reset");

    return 0;
}



































































