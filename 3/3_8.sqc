


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<stdbool.h>
#include<sql.h>

EXEC SQL INCLUDE SQLCA;


//deklaracije funkcija

EXEC SQL BEGIN DECLARE SECTION;
char hPrezime[51];
char hDatum[11];
char hIme[51];
char hPredmet[151];
EXEC SQL END DECLARE SECTION;



void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "Greska! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
}



int main(int argc, char* argv[])
{
    
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    
/*
Zadatak 3.8: Napisati C/SQL program koji ispisuje za svakog studenta ime, prezime, poslednji položeni ispit (naziv predmeta koji je položen), kao i datum polaganja tog ispita.



*/
    
    EXEC SQL 
        DECLARE cStudent CURSOR FOR 
        SELECT  IME, PREZIME, NAZIV, DATPOLAGANJA
        FROM    DA.ISPIT I JOIN DA.PREDMET P ON I.IDPREDMETA = P.ID JOIN
                DA.DOSIJE D ON D.INDEKS = I.INDEKS
        WHERE   I.OCENA > 5 AND I.STATUS = 'o' AND NOT EXISTS (
                    SELECT *
                    FROM DA.ISPIT I1
                    WHERE I1.OCENA > 5 AND I1.STATUS = 'o' AND I1.INDEKS = I.INDEKS AND 
                            I1.DATPOLAGANJA > I.DATPOLAGANJA
        );
    checkSQL("DECLARE");
    
    EXEC SQL OPEN cStudent;
    checkSQL("OPEN");
  
    while(1)
    {
        EXEC SQL 
            FETCH   cStudent
            INTO    :hIme, :hPrezime, :hPredmet, :hDatum;
        checkSQL("FETCH");
        
        
        if(SQLCODE == 100)
            break;
        
        printf("%s %s %s %s\n", hIme, hPrezime, hPredmet, hDatum);
    }
    
    EXEC SQL CLOSE cStudent;
    checkSQL("CLOSE");
    
    EXEC SQL COMMIT;
    checkSQL("COMMIT PRE KRAJA");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}



















