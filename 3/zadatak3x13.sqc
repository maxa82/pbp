


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<stdbool.h>
#include<sql.h>

EXEC SQL INCLUDE SQLCA;


//deklaracije funkcija

EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hIndeks;
char hIme[51];
char hPrezime[51];
char hOznakaRoka[21];
short h1Ocena;
short hOcena;
short hGodinaRoka;
char hNaziv[151];
double hProsecna;
EXEC SQL END DECLARE SECTION;



void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "Greska! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
}



int main(int argc, char* argv[])
{
    
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    
/*
Zadatak 3.13: Napisati C/SQL program kojim se omogućava nastavniku da unese naziv predmeta, godinu roka i oznaku roka. Za svako polaganje datog predmeta u datom ispitnom roku ponuditi nastavniku mogućnost da izmeni ocenu koju je student osvojio. Ispisati informacije o indeksu, imenu i prezimenu studenta kao i ocenu koju je dobio, pa zatražiti od nastavnika novu ocenu. Nakon unosa nove ocene, obavestiti nastavnika o uspešnosti izmene i preći na naredno polaganje (ukoliko ih ima više).



*/
    printf("unesite naziv predmeta, godinu roka i oznaku roka: \n");
    
    fgets(hNaziv, sizeof(hNaziv), stdin);
    hNaziv[strcspn(hNaziv, "\n")] = '\0';
    //getchar();
    
    scanf("%hd %s", &hGodinaRoka, hOznakaRoka);
    getchar();
    
   // printf("%s %hd %s\n", hNaziv, hGodinaRoka, hOznakaRoka);
   
   // char odg = getchar(); getchar();
    
   // printf("A%c\n", odg);
    
   //return 0;
    
    EXEC SQL 
        DECLARE     cStudentiNovaOcena  CURSOR FOR
        SELECT      I.INDEKS,
                    (SELECT IME FROM DA.DOSIJE WHERE INDEKS = I.INDEKS),
                    (SELECT PREZIME FROM DA.DOSIJE WHERE INDEKS = I.INDEKS),
                    I.OCENA 
        FROM        DA.ISPIT I
        WHERE       I.OCENA IS NOT NULL AND I.IDPREDMETA IN (SELECT P.ID FROM DA.PREDMET P WHERE P.NAZIV = :hNaziv) AND
                    I.SKGODINA = :hGodinaRoka AND  I.OZNAKAROKA = :hOznakaRoka
        FOR         UPDATE OF OCENA;
    checkSQL("DECLARE CURSOR");
    
    
    EXEC SQL OPEN cStudentiNovaOcena;
    checkSQL("OPEN");
                    // Diskretne strukture 1

    while(1)
    {
        EXEC SQL 
            FETCH       cStudentiNovaOcena
            INTO        :hIndeks,
                        :hIme,
                        :hPrezime,
                        :hOcena;
        checkSQL("FETCH");
        
        if(SQLCODE == 100)
            break;
        
        printf("%d %s %s %hd. Da li zelite da uneste novu ocenu za datog studenta? [d/n]\n", hIndeks, hIme, hPrezime, hOcena);
        char odg = getchar(); getchar();
        
        if(odg == 'd')
        {
            printf("Unesite novu ocenu [5 - 10]:\n");
            
            
            scanf("%hd", &h1Ocena);
            getchar();
            
            
            EXEC SQL 
                    UPDATE  DA.ISPIT
                    SET OCENA = :h1Ocena
                    WHERE   CURRENT OF cStudentiNovaOcena;
           checkSQL("UPDATE");
           
           printf("UPDATE je uspesno izvrsen! Nova ocena za studenta %s %s je %hd, dok je stara bila %hd!\n", hIme, hPrezime, h1Ocena, hOcena);
            
            
            
        }else{
            printf("Ocena nije izmenjena!\n");
        }
        
        
        
    }
    
    EXEC SQL CLOSE cStudentiNovaOcena;
    checkSQL("CLOSE");
                

    EXEC SQL COMMIT;
    checkSQL("COMMIT PRE KRAJA");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}




















