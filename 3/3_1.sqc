


#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<stdbool.h>
#include<sql.h>

EXEC SQL INCLUDE SQLCA;


/**
 * 
 * Zadatak 3.1: Napisati C/SQL program koji ispisuje identifikator, oznaku, naziv,                      nivo, broj bodova, zvanje i opis za svaki od studijskih programa.
 * 
 */


//deklaracije funkcija

EXEC SQL BEGIN DECLARE SECTION;
sqlint32 hId;
char hOznaka[11];
char hNaziv[51];
short hIdNivoa;
short hObimESPB;
char hZvanje[101];
struct {
   short int length;
   char data[32700];
} hOpis;
short iOpis;
EXEC SQL END DECLARE SECTION;



void checkSQL(const char *msg)
{
    if(SQLCODE < 0)
    {
        char Buffer[1024];
        short BufferSize = sizeof(Buffer);
        short LineWidth = 50;
        
        sqlaintp(Buffer, BufferSize, LineWidth, &sqlca);
        
        fprintf(stderr, "Greska! %d %s\n", SQLCODE, msg);
        fprintf(stderr, "%s\n", Buffer);
        
        EXEC SQL ROLLBACK;
        
        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
        
    }
}



int main(int argc, char* argv[])
{
    
    EXEC SQL CONNECT TO STUD2020 USER student USING abcdef;
    checkSQL("CONNECT TO");
    
    EXEC SQL 
        DECLARE cStudProg CURSOR FOR
        SELECT  ID,
                OZNAKA,
                NAZIV,
                IDNIVOA,
                OBIMESPB,
                ZVANJE,
                OPIS
        FROM    DA.STUDIJSKIPROGRAM;
    checkSQL("DECLARE CURSOR");
    
    EXEC SQL OPEN cStudProg;
    checkSQL("OPEN");
    
    while(1)
    {
        EXEC SQL 
            FETCH cStudProg
            INTO    :hId,
                    :hOznaka,
                    :hNaziv,
                    :hIdNivoa,
                    :hObimESPB,
                    :hZvanje,
                    :hOpis :iOpis;
        checkSQL("FETCH");
        
        if(SQLCODE == 100)
            break;
            
        
        printf("\n\n%d %s %s %hd %hd %s \n\n%s\n\n", hId,
                    hOznaka,
                    hNaziv,
                    hIdNivoa,
                    hObimESPB,
                    hZvanje,
                    (iOpis < 0) ? "NULL" : hOpis.data);
        
    }
    
    
    
    EXEC SQL CLOSE cStudProg;
    checkSQL("CLOSE");
    
    
    EXEC SQL COMMIT;
    checkSQL("COMMIT PRE KRAJA");
    
    EXEC SQL CONNECT RESET;
    checkSQL("CONNECT RESET");
    
    return 0;
}



















